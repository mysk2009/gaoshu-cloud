# 云端服务环境变量示例（复制成 Render 的环境变量，不要提交真实值）
#
# 数据库连接串。
#   Neon：postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   本地测试：sqlite:///cloud/data/cloud_test.db
CLOUD_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# 管理员口令：老师第一次上线导名单时用（导完可以不再用）
CLOUD_ADMIN_TOKEN=change-me-admin

# 老师 / 教授共用登录口令：进看板要输的那个
CLOUD_TEACHER_PASSWORD=change-me-teacher

# 登录 token 的签名密钥，随便一串长随机字符
CLOUD_SECRET_KEY=change-me-long-random-string
